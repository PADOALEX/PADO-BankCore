# DEVELOPMENT ONLY. Copy to .env and replace both placeholders before docker compose up.
BANKCORE_DB_PASSWORD=REPLACE_WITH_LOCAL_DEV_DB_PASSWORD
BANKCORE_JWT_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS_LONG
# Optional: do not enable unless you explicitly want disposable demo accounts.
BANKCORE_DEMO_PASSWORD=REPLACE_WITH_DEMO_PASSWORD_AT_LEAST_12_CHARS
